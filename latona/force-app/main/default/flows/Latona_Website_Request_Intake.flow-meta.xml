    <description>Routes a website request (called by the website webhook endpoint). Email matches a Contact: creates an Opportunity (stage Request) on the Contact&apos;s Account. Email matches an open Lead: updates the Lead&apos;s request fields and adds a Task. Otherwise: creates a new Lead with LeadSource = Website. Outputs outResult (OpportunityCreated / LeadUpdated / LeadCreated) and outRecordId.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxAccountOwnerId</name>
        <dataType>String</dataType>
        <expression>{!getContact.Account.OwnerId}</expression>
    </formulas>
    <formulas>
        <name>fxCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!inDeadline}), {!$Flow.CurrentDate} + 30, {!inDeadline})</expression>
    </formulas>
    <formulas>
        <name>fxCommentProvided</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inComment}))</expression>
    </formulas>
    <formulas>
        <name>fxEmailProvided</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK(TRIM({!inEmail})))</expression>
    </formulas>
    <formulas>
        <name>fxLeadDeadline</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!inDeadline}, {!getOpenLead.Deadline__c})</expression>
    </formulas>
    <formulas>
        <name>fxLeadFormat</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!inFormat}, {!getOpenLead.Format__c})</expression>
    </formulas>
    <formulas>
        <name>fxLeadProduct</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!inProductRequested}, {!getOpenLead.Product_Requested__c})</expression>
    </formulas>
    <formulas>
        <name>fxLeadQuantity</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!inQuantity}, {!getOpenLead.Quantity__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxNewLeadCompany</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(ISBLANK({!inCompany}), TRIM({!inFirstName} &amp; &quot; &quot; &amp; {!fxNewLeadLastName}), {!inCompany}), 255)</expression>
    </formulas>
    <formulas>
        <name>fxNewLeadLastName</name>
        <dataType>String</dataType>
        <expression>LEFT(IF(ISBLANK({!inLastName}), BLANKVALUE({!inEmail}, &quot;Website visitor&quot;), {!inLastName}), 80)</expression>
    </formulas>
    <formulas>
        <name>fxOpportunityName</name>
        <dataType>String</dataType>
        <expression>LEFT({!getContact.Account.Name} &amp; &quot; - &quot; &amp; BLANKVALUE({!inProductRequested}, &quot;Website request&quot;), 120)</expression>
    </formulas>
    <formulas>
        <name>fxTaskOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!getOpenLead.OwnerId}, 3) = &quot;005&quot;, {!getOpenLead.OwnerId}, {!$User.Id})</expression>
    </formulas>
    <interviewLabel>Latona Website Request Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Latona Website Request Intake</label>
